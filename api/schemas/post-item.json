{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "enum": [
        "phone",
        "laptop-tablet",
        "headphones",
        "charger-cable",
        "wallet-id",
        "keys",
        "bag",
        "water-bottle",
        "clothing",
        "glasses",
        "jewelry-watch",
        "books-notes",
        "calculator-supplies",
        "other"
      ]
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 16,
        "enum": [
          "black",
          "white",
          "gray",
          "red",
          "orange",
          "yellow",
          "green",
          "blue",
          "purple",
          "pink",
          "brown",
          "multicolor"
        ]
      }
    },
    "foundLocation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "foundAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  },
  "required": ["title", "category", "colors", "foundLocation", "foundAt"],
  "additionalProperties": false
}
