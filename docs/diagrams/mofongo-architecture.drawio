        <mxCell id="1" parent="0"/>

        <mxCell id="a1" value="1-2. Finder opens app&#xa;and signs in" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#F5F5F5;strokeColor=#232F3E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="3. Get upload link&#xa;API Gateway + Lambda" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="4. Upload photo&#xa;browser to S3" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="30" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="5. Upload event&#xa;S3 to SQS queue" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="30" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="6. Worker tags photo&#xa;CLIP on EC2" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="30" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="b5" value="7. Save tags&#xa;DynamoDB" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="250" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="8-9. Find matches&#xa;Stream + Lambda" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="250" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="Open report&#xa;matches?" style="rhombus;html=0;fontSize=22;fontColor=#232F3E;fillColor=#E8F0FE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="230" width="280" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="Item stays listed;&#xa;a later report&#xa;triggers the match" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="250" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="10-11. Email to owner&#xa;via SNS (subscribed&#xa;when report filed)" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#FFF2E0;strokeColor=#ED7100;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="470" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c4" value="12. Owner collects&#xa;item at front desk" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#F5F5F5;strokeColor=#232F3E;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="470" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c5" value="13. Item marked&#xa;as returned" style="rounded=1;arcSize=14;html=0;fontSize=22;fontColor=#232F3E;fillColor=#E7F4E4;strokeColor=#248814;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1340" y="470" width="280" height="110" as="geometry"/>
        </mxCell>

